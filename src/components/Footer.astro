---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__title">Donne Resistenti</p>
    <p>Una mostra sul ruolo delle donne nelle resistenze, nella storia e nel mondo.</p>
    <p class="site-footer__meta">© {year} Donne Resistenti</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-lg);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-xs);
  }

  .site-footer__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-green);
  }

  .site-footer__meta {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    opacity: 0.7;
  }
</style>
