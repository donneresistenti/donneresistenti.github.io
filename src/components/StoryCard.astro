---
import type { CollectionEntry } from 'astro:content';
import TornPhoto from './TornPhoto.astro';

interface Props {
  story: CollectionEntry<'stories'>;
  index: number;
}

const { story, index } = Astro.props;
const { title, place, period, excerpt, cover, coverAlt } = story.data;
const href = `${import.meta.env.BASE_URL}storie/${story.id}/`;
---

<article class="story-card">
  <TornPhoto src={cover} alt={coverAlt ?? ''} seed={index * 7 + 5} class="story-card__photo" sizes="(min-width: 768px) 33vw, 100vw" />
  <p class="story-card__meta">{place} · {period}</p>
  <h3 class="story-card__title">
    <a href={href}>{title}</a>
  </h3>
  <p class="story-card__excerpt">{excerpt}</p>
</article>

<style>
  .story-card {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .story-card :global(.story-card__photo) {
    margin-bottom: var(--space-xs);
    transition: transform 0.35s ease;
  }

  .story-card:hover :global(.story-card__photo),
  .story-card:focus-within :global(.story-card__photo) {
    transform: rotate(-1.2deg) scale(1.02);
  }

  .story-card__meta {
    font-family: var(--font-display);
    font-size: var(--text-base);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .story-card__title {
    font-size: var(--text-h3);
  }

  .story-card__title a {
    text-decoration: none;
  }

  /* L'intera card è cliccabile */
  .story-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .story-card__excerpt {
    color: var(--color-ink-soft);
  }
</style>
