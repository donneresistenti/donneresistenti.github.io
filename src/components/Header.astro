---
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}#storie`, label: 'Storie' },
  { href: `${base}#progetto`, label: 'Il progetto' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={base} aria-label="Donne Resistenti, torna alla home">
      Donne <span>Resistenti</span>
    </a>
    <nav aria-label="Navigazione principale">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    padding-block: var(--space-md);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-red);
  }

  .wordmark span {
    color: var(--color-ink);
  }

  ul {
    display: flex;
    gap: var(--space-md);
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    background: linear-gradient(var(--color-green), var(--color-green)) no-repeat 0 100% / 0 0.35em;
    transition: background-size 0.25s ease;
  }

  nav a:hover,
  nav a:focus-visible {
    background-size: 100% 0.35em;
  }
</style>
